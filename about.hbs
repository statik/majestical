<h1>Third-party licenses</h1>
<p>
  Majestical bundles the Rust crates below. This page lists each license that
  applies and the crates distributed under it.
</p>
<ul>
  {{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> — {{count}} crate(s)</li>
  {{/each}}
</ul>
{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<p>Used by:</p>
<ul>
  {{#each used_by}}
  <li>
    <a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}"
      >{{crate.name}} {{crate.version}}</a
    >
  </li>
  {{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
