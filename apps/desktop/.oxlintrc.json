{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn"],
  // The e2e project (apps/desktop/e2e) is its own standalone package with
  // its own lockfile and its own .oxlintrc.json/lint script (run by the
  // gui-e2e CI job after that package's own `pnpm install`) — linting it
  // from here would report unresolved imports on every OS in the `gui`
  // matrix, since only the gui-e2e job (macOS-only) ever installs its deps.
  "ignorePatterns": ["e2e/**"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "warn"
  },
  "rules": {
    // Vite's CSS entry (`import "./app.css"`) is a side-effect import by
    // design; there is nothing to assign it to.
    "import/no-unassigned-import": "off"
  },
  "overrides": [
    {
      // `api.ts` is the hand-written wire contract with `commands.rs`: one
      // interface plus one wrapper per Tauri command, growing by design as
      // organize/ingest surfaces land (phase 7C's watchlist already tracks
      // "api.ts codegen" as the eventual fix for this file's size). Default
      // 300 is the wrong gate for a file whose length tracks the command
      // count, not its complexity. Raised for the ingest surface, which
      // mirrors the deepest outcome in the app: a run carries the engine's
      // whole `Outcome` (five per-file lists) plus a seven-variant progress
      // union. Raised again for phase 7E's always-on wire (scheduler state,
      // throttle, power) with room for the doctor report that lands next
      // to it. Lowered back down for phase 7F: the always-on/health subject
      // (scheduler + doctor types and their wrappers) moved to
      // `api-alwayson.ts`. The next raise is refused: the ingest subject
      // (plan/run/progress types and their wrappers) moves to
      // `api-ingest.ts` next.
      "files": ["src/lib/api.ts"],
      "rules": {
        "max-lines": ["warn", { "max": 560 }]
      }
    },
    {
      // `BrowseView.svelte` is the one surface built of four parts — the
      // folder tree, the breadcrumb, the chip toolbar and the paged grid —
      // and the multi-selection wiring is the last thing to join them. The
      // rules it wires in are already modules of their own (`selection.ts`,
      // `browse-paths.ts`), so what is left in the file is the surface
      // itself; the fix when it next grows is to lift the tree column into
      // its own component, not to delete the comments that say why each
      // part behaves as it does. The cap sits two lines above where the
      // script block is today (oxlint counts the script block, 308 lines),
      // so nearly any growth forces the split.
      "files": ["src/lib/BrowseView.svelte"],
      "rules": {
        "max-lines": ["warn", { "max": 310 }]
      }
    },
    {
      // `IngestView.svelte` is the surface with three states rather than
      // one — a setup board, a live run, and a completion card — plus the
      // resume banner, and the run is the only thing in the app whose
      // state lives in the backend and has to be rejoined on mount. All of
      // its arithmetic is already out of the file: `ingest-progress.ts`
      // (the event accumulator, the bar, the estimate) and
      // `ingest-plan.ts` (the plan's five counters). What is left is the
      // orchestration and the declared wire-gap ledger, which is what a
      // surface is. The cap sits three lines above where the script block
      // is today (oxlint counts the script block, 530 lines), so nearly
      // any growth forces the next split: lifting the run panel — the
      // preparing/running/finishing states, the progress subscription and
      // the outcome poll — into a component of its own.
      "files": ["src/lib/IngestView.svelte"],
      "rules": {
        "max-lines": ["warn", { "max": 533 }]
      }
    },
    {
      // The shell mounts one component per surface, so its import count is
      // the number of surfaces plus the handful of shared pieces — the
      // measure this rule is for (incidental coupling) is not what it is
      // counting here. Raised by one for phase 7F's api.ts split:
      // `NAVIGATE_SETTINGS_EVENT` now comes from its own `api-alwayson.ts`
      // module alongside `./lib/api`.
      "files": ["src/App.svelte"],
      "rules": {
        "import/max-dependencies": ["warn", { "max": 14 }]
      }
    },
    {
      // A suite's length tracks how many behaviours it pins, not how
      // complicated any of them is, and both of these are already split by
      // subject: the shell and the Ingest setup board, beside a live-run
      // suite (225 lines) and an outcome suite (243) that are under the
      // default and stay there. Raised again for phase 7E: the shell suite
      // (376 lines) picked up `ALWAYS_ON`, the two commands every Settings
      // mount now needs mocked (`AlwaysOnSection` mounts alongside the
      // health panel and asks `scheduler_state`/`plugin:autostart|
      // is_enabled` on mount) — not a new subject, just the existing
      // Settings-surface test paying for a sibling component's mount
      // effects. The cap sits just above that, so the next subject still
      // gets its own file — which is what keeps them findable — rather
      // than being folded in here. Next raise is refused: the two
      // Settings-shell tests ("the settings surface swaps in with the
      // doctor's health rows" and "the tray's navigate-settings event
      // selects the Settings surface") move to their own
      // `src/App.settings.test.ts` instead.
      "files": ["src/App.test.ts", "src/lib/IngestView.test.ts"],
      "rules": {
        "max-lines": ["warn", { "max": 385 }]
      }
    },
    {
      // `ALWAYS_ON`'s `scheduler_state` mock reuses `scheduler_state.json`
      // (also imported by `AlwaysOnSection.test.ts` and `fixtures.test.ts`)
      // rather than inlining a third copy of the wire shape, which is the
      // one dependency over the default here. Raised by one more for phase
      // 7F's api.ts split: `NAVIGATE_SETTINGS_EVENT` now comes from its own
      // `api-alwayson.ts` module alongside `./lib/api`. Same next-split
      // plan as the `max-lines` override above: the two Settings-shell
      // tests move to `src/App.settings.test.ts`, taking this import with
      // them.
      "files": ["src/App.test.ts"],
      "rules": {
        "import/max-dependencies": ["warn", { "max": 12 }]
      }
    },
    {
      // `fixtures.test.ts` assigns one committed fixture per pinned outcome
      // struct (see its own header comment) — its import count tracks the
      // number of Tauri commands, not incidental coupling.
      "files": ["src/lib/fixtures.test.ts"],
      "rules": {
        "import/max-dependencies": ["warn", { "max": 26 }]
      }
    }
  ]
}
